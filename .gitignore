# Foundry
out/
cache/
**/broadcast/*/dry-run/
# Foundry broadcast logs.
#
# Keeping deployment receipts for a real network is reasonable; keeping them for a local chain is
# not. Anvil hands out the same addresses every run, so a stale local receipt looks authoritative
# and is wrong. Only local-chain runs are ignored here.
**/broadcast/*/31337/
lcov.info

# Node
node_modules/
.next/
dist/
build/
coverage/
*.tsbuildinfo

# Env and secrets
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Anchor / Solana
target/
.anchor/
test-ledger/
**/*.rs.bk

# Cargo.lock IS committed. A deployed Solana program should be reproducibly buildable, and that
# requires pinning the exact dependency graph the .so was built from.

