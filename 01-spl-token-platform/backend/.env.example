# Copy to .env and fill in. Every value is validated at boot, so a typo fails fast.

NODE_ENV=development
LOG_LEVEL=debug

PORT=4004
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://solplatform:solplatform@localhost:5436/solplatform?schema=public

# mainnet-beta | devnet | testnet | localnet
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# Many providers serve websockets on a different host, and web3.js does not infer it reliably.
RPC_WS_URL=

# Printed by `anchor deploy`, and also in Anchor.toml.
PROGRAM_ID=HxRsEhSd2zBMTDDmQsiR4jA1ZGjdQVybjXrwHAedJUDJ

INDEXER_POLL_INTERVAL=10
SIGNATURE_PAGE_SIZE=500

# Required for POST /airdrop/build. Publishing a Merkle root decides who receives tokens, so that
# route is not open. Minimum 16 characters.
ADMIN_API_KEY=
