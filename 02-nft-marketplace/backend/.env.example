NODE_ENV=development
LOG_LEVEL=debug

PORT=4005
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://solnft:solnft@localhost:5437/solnft?schema=public

CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
RPC_WS_URL=

# A DAS-capable endpoint, needed to read compressed NFTs. Helius, Triton and QuickNode implement it;
# the public Solana endpoints do NOT. Falls back to RPC_URL, and the API reports the missing method
# clearly rather than failing opaquely.
DAS_RPC_URL=

PROGRAM_ID=MKTPmzcYRt3EWo5oPgQsUt1V5AqQbEPQeq7pQBhMqRj

INDEXER_POLL_INTERVAL=10
SIGNATURE_PAGE_SIZE=500

# Required for the allowlist upload route. Publishing a root decides who can mint.
ADMIN_API_KEY=
